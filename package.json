  "description": "Reproductor de vinilo interactivo con scratching y temas dinámicos",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --port 5555\" \"wait-on http://localhost:5555 && electron .\"",
    "build": "vite build",
    "electron:build": "pnpm build && electron-builder --win -p never",
    "build-win": "electron-builder --win -p never",
    "serve": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "Anthony Abril",
    "email": "antabrrue@alu.edu.gva.es"
  },
